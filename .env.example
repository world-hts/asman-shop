# Store identity / fallback values
NEXT_PUBLIC_STORE_NAME=Asman Shop
NEXT_PUBLIC_STORE_PHONE=+993 71 76 76 76
NEXT_PUBLIC_STORE_LOCATION=Türkmenistan Asgabat, 744000, Köpetdag etraby, 1-nji etrap, 1-nji köçe, 1-nji jaý

# Supabase (optional for local demo; required for live data)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Public canonical URL for production metadata (replace placeholder before deployment)
NEXT_PUBLIC_SITE_URL=https://YOUR-DOMAIN.example

# Legacy Supabase anon key is accepted as a fallback, but publishable key is preferred.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
