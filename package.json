{
  "name": "asman-shop",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "verify": "node scripts/verify_project.mjs",
    "typecheck": "tsc --noEmit",
    "quality": "pnpm run verify && pnpm run audit && pnpm run audit:functionality && pnpm run lint && pnpm run typecheck && pnpm run build",
    "audit": "node scripts/audit_project.mjs",
    "audit:functionality": "node scripts/audit_functionality.mjs",
    "security:prod": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "@supabase/ssr": "^0.12.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.18.0"
}
